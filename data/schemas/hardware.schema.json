{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lexa AsymCompute hardware system",
  "type": "object",
  "required": ["name", "devices"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "devices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "compute_tflops", "memory_bandwidth_gbps", "memory_gib"],
        "properties": {
          "name": {"type": "string"},
          "compute_tflops": {"type": "number", "exclusiveMinimum": 0},
          "memory_bandwidth_gbps": {"type": "number", "exclusiveMinimum": 0},
          "memory_gib": {"type": "number", "exclusiveMinimum": 0},
          "compute_efficiency": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
          "bandwidth_efficiency": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
          "fixed_latency_ms": {"type": "number", "minimum": 0},
          "power_watts": {"type": "number", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "links": {"type": "array"}
  },
  "additionalProperties": false
}
