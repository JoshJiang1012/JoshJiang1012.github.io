{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/lexa/router_trace.schema.json",
  "title": "Lexa HyperMoE router event",
  "type": "object",
  "required": ["token", "layer", "experts"],
  "properties": {
    "token": {"type": "integer", "minimum": 0},
    "layer": {"type": "integer", "minimum": 0},
    "experts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    },
    "domain": {"type": "string", "maxLength": 128},
    "timestamp_ns": {"type": "integer", "minimum": 0},
    "gpu_hits": {"type": "integer", "minimum": 0},
    "ram_hits": {"type": "integer", "minimum": 0},
    "nvme_misses": {"type": "integer", "minimum": 0},
    "layer_latency_us": {"type": "number", "minimum": 0}
  },
  "additionalProperties": true
}
